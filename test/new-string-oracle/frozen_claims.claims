# Hand-written claims for frozen_claims.rb: a true and a false claim of the
# `frozen` check (the object is frozen). The tool must disprove the claims on
# the unfrozen Strings and no other:
#
# disproved: need-argv-env 8:10
# disproved: need-argv-env 9:7
#
# The literal is frozen (--enable-frozen-string-literal), so is an ENV String,
# and a missing key answers nil, which is no String; `+"..."` and a copy are not.
need-argv-env	frozen_claims.rb	5	6	5	15	StringNode	-	check=frozen
need-argv-env	frozen_claims.rb	6	6	6	27	CallNode	fetch	check=frozen
need-argv-env	frozen_claims.rb	7	10	7	38	CallNode	[]	check=frozen
