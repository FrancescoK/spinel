# Hand-written claims for true_and_false_claims.rb: a true claim and a false
# one for each check. The lines below say which the tool must disprove, as
# "kind line:col" (the claimed node's start); it must disprove exactly these.
#
# disproved: ret-new 10:0
# disproved: ret-param 12:0
# disproved: value 14:11
# disproved: need-one-name 16:6
# disproved: elems 20:16
# disproved: mystery 21:10
# disproved: odd 14:11
#
# A kind with no check field (mystery) and one with a check the tool does not
# know (odd) are reported and checked as `new`; a check=none claim is listed,
# not checked, even though this one is false.
ret-new	true_and_false_claims.rb	9	0	9	18	DefNode	fresh	check=new
ret-new	true_and_false_claims.rb	10	0	10	30	DefNode	held	check=new
ret-param	true_and_false_claims.rb	11	0	11	15	DefNode	same	check=param	param=x
ret-param	true_and_false_claims.rb	12	0	12	20	DefNode	other	check=param	param=x
value	true_and_false_claims.rb	13	12	13	17	CallNode	fresh	check=new
value	true_and_false_claims.rb	14	11	14	15	CallNode	held	check=new
need-one-name	true_and_false_claims.rb	16	6	16	8	GlobalVariableReadNode	$a	check=one-name
need-one-name	true_and_false_claims.rb	17	6	17	8	GlobalVariableReadNode	$c	check=one-name
elems	true_and_false_claims.rb	20	2	20	14	ArrayNode	-	check=elems
elems	true_and_false_claims.rb	20	16	20	22	ArrayNode	-	check=elems
mystery	true_and_false_claims.rb	21	10	21	14	CallNode	held
odd	true_and_false_claims.rb	14	11	14	15	CallNode	held	check=weird
skipped	true_and_false_claims.rb	21	10	21	14	CallNode	held	check=none
