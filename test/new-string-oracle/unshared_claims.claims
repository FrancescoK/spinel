# Hand-written claims for unshared_claims.rb: every new String is claimed
# unshared (it is never changed in place while a second name can reach it).
# The tool must disprove the Strings changed while a second name holds them,
# as "kind line:col" (the claimed node's start), and no other:
#
# disproved: need-unshared 24:7
# disproved: need-unshared 29:7
# disproved: need-unshared 35:5
# disproved: need-unshared 45:6
# disproved: need-unshared 55:7
# disproved: need-unshared 55:13
#
# 24 is changed while `other` holds it and is read again, 29 while $g does, 35
# while the Holder's ivar does, 45 while `arg` does (and the parameter), 55 and
# 55:13 are the two elements, held by the Array and by the block's parameter.
# The rest are changed while one name holds them: 20 `alone`, 40 `dead` (its
# second name `gone` is never read again), 49 a temporary passed to a method
# that changes its parameter, 51 a String changed through its own receiver
# `self`, `cap`, which a Proc also holds, but through the same variable, `cur`,
# whose second name is assigned again before it is read, a String that
# unicode_normalize! works on, and the buffer the standard library's pp
# appends to in frames of its own.
need-unshared	unshared_claims.rb	20	8	20	16	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	24	7	24	14	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	29	7	29	14	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	35	5	35	10	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	40	7	40	14	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	45	6	45	12	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	49	5	49	12	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	51	7	51	14	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	55	7	55	11	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	55	13	55	17	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	59	6	59	12	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	64	6	64	12	CallNode	+@	check=unshared
need-unshared	unshared_claims.rb	70	6	70	30	CallNode	pack	check=unshared
need-unshared	unshared_claims.rb	75	6	75	9	CallNode	+@	check=unshared
