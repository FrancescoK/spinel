class LtApp
  def or_right: (untyped v) -> String
  def or_left: (untyped v) -> String
  def or_paren: (untyped v) -> String
  def and_right: (untyped v) -> String
  def or_local: () -> String
  def or_fresh: (untyped v) -> String
end

class LtApp2
  def nest_left: (untyped v) -> String
  def nest_and: (untyped v) -> String
  def nest_or3: () -> String
  def nest_swap: (untyped v) -> String
  def nest_cond: (untyped v) -> String
  def ivar_left: (untyped v) -> String
  def local_left: (untyped v) -> String
end
