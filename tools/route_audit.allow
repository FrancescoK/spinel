# tools/route_audit.rb: the files whose call targets go through call_target
# (call_plan.c), and their by-name lookups that ask about a name rather than
# one call, each with why. `FILE FUNCTION [LOOKUP | =NAME] reason`: with
# LOOKUP only that lookup of the function is by name, with =NAME only the
# lookups whose name argument is NAME.
files: src/analyze.c src/analyze_cls.c src/analyze_desugar.c src/analyze_infer.c
files: src/analyze_infer_recv.c src/analyze_nil.c src/analyze_pass.c
files: src/analyze_scope.c src/analyze_util.c src/call_plan.c src/compiler.c src/repr.c

